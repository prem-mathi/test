import streamlit as st
from pyvis.network import Network
import networkx as nx
import streamlit.components.v1 as components
from pathlib import Path
import os

# Set page config
st.set_page_config(
    page_title="Interactive Graph Visualization",
    layout="wide"
)


# Function to create sample graph
def create_sample_graph():
    G = nx.random_geometric_graph(15, 0.3)

    # Add node attributes
    for i, node in enumerate(G.nodes()):
        # Add simple title for hover tooltip
        G.nodes[node]['title'] = f"Node {node}"
        G.nodes[node]['label'] = f"Node {node}"
        G.nodes[node]['id'] = node
        # Store additional data for custom popups
        G.nodes[node]['type'] = ['Data', 'Process', 'Input/Output'][i % 3]
        G.nodes[node]['value'] = round(i * 2.5, 2)
        # Add various colors for nodes
        if i % 3 == 0:
            G.nodes[node]['color'] = '#FF6B6B'
        elif i % 3 == 1:
            G.nodes[node]['color'] = '#4ECDC4'
        else:
            G.nodes[node]['color'] = '#FFD166'

    return G


# Function to convert networkx graph to pyvis with custom popup functionality
def create_pyvis_graph(nx_graph):
    # Configure pyvis network
    pyvis_graph = Network(
        height="600px",
        width="100%",
        bgcolor="#ffffff",
        font_color="#333333"
    )

    # Copy nodes and edges from networkx graph
    for node, node_attrs in nx_graph.nodes(data=True):
        pyvis_graph.add_node(node, **node_attrs)

    for source, target, edge_attrs in nx_graph.edges(data=True):
        # Add some edge attributes
        edge_data = {
            'title': f"Edge from {source} to {target}",
            'color': '#999999'
        }
        edge_data.update(edge_attrs)
        pyvis_graph.add_edge(source, target, **edge_data)

    # Configure physics
    pyvis_graph.barnes_hut(
        gravity=-80000,
        central_gravity=0.3,
        spring_length=200,
        spring_strength=0.05,
        damping=0.09
    )

    # Add popup configuration and interactivity options
    pyvis_graph.set_options("""
    {
        "nodes": {
            "shape": "dot",
            "size": 20,
            "font": {
                "size": 14,
                "face": "Tahoma"
            },
            "borderWidth": 2,
            "shadow": true
        },
        "edges": {
            "width": 2,
            "shadow": true,
            "smooth": {
                "type": "continuous",
                "roundness": 0.5
            }
        },
        "interaction": {
            "hover": true,
            "hoverConnectedEdges": true,
            "selectConnectedEdges": true,
            "navigationButtons": true,
            "keyboard": true,
            "tooltipDelay": 100
        },
        "physics": {
            "stabilization": {
                "iterations": 100,
                "fit": true
            }
        },
        "manipulation": {
            "enabled": false
        }
    }
    """)

    return pyvis_graph


def save_and_display_graph(pyvis_graph, nx_graph):
    # Create a directory for the html file
    temp_dir = Path("temp_pyvis_html")
    temp_dir.mkdir(exist_ok=True)

    # Generate a unique file name
    html_path = temp_dir / "pyvis_graph.html"

    # Save the graph as HTML
    pyvis_graph.save_graph(str(html_path))

    # Enhance the HTML with custom popup functionality
    with open(html_path, 'r', encoding='utf-8') as file:
        html_content = file.read()

    # Create a dictionary of node data for the custom popups
    node_data = {}
    for node, attrs in nx_graph.nodes(data=True):
        node_data[node] = {
            'id': node,
            'type': attrs.get('type', 'Unknown'),
            'value': attrs.get('value', 0)
        }

    # Create custom popup code
    # This JavaScript creates styled HTML popups directly in the DOM
    custom_js = """
    <style>
    .node-popup {
        position: fixed;
        background-color: white;
        padding: 10px;
        border-radius: 5px;
        border: 1px solid #ddd;
        width: 250px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        z-index: 1000;
        display: none;
        top: 20px;
        right: 20px;
    }
    .node-popup h3 {
        margin-top: 0;
        color: #333;
    }
    </style>

    <div id="node-popup" class="node-popup"></div>

    <script>
    // Node data from Python
    const nodeData = """ + str(node_data).replace("'", '"') + """;

    // Create a popup element
    const popup = document.getElementById('node-popup');
    let activeNode = null;

    // Position the popup in the top right corner of the canvas
    function positionPopupTopRight() {
        const canvas = document.getElementById('mynetwork');
        const canvasRect = canvas.getBoundingClientRect();

        // Position in top right with some padding
        popup.style.left = (canvasRect.right - popup.offsetWidth - 20) + 'px';
        popup.style.top = (canvasRect.top + 20) + 'px';
    }

    // Add click event to show popup
    network.on("click", function(params) {
        if (params.nodes.length > 0) {
            const nodeId = params.nodes[0];
            const node = network.body.nodes[nodeId];

            // Get node data
            const data = nodeData[nodeId];
            if (data) {
                // Create popup content
                popup.innerHTML = `
                    <h3 style="margin-top: 0; color: #333;">Node ${data.id}</h3>
                    <p><strong>ID:</strong> ${data.id}</p>
                    <p><strong>Type:</strong> ${data.type}</p>
                    <p><strong>Value:</strong> ${data.value}</p>
                `;

                // Display the popup
                popup.style.display = 'block';

                // Position popup in top right corner
                positionPopupTopRight();

                // Store active node
                activeNode = nodeId;
            }
        } else {
            // Hide popup when clicking elsewhere
            popup.style.display = 'none';
            activeNode = null;
        }
    });

    // Hide popup when canvas is dragged
    network.on("dragStart", function() {
        popup.style.display = 'none';
        activeNode = null;
    });

    // Keep popup in top right even when zoomed or panned
    window.addEventListener('resize', function() {
        if (activeNode !== null) {
            positionPopupTopRight();
        }
    });
    </script>
    """

    # Insert custom JS before the closing body tag
    modified_html = html_content.replace('</body>', f'{custom_js}</body>')

    with open(html_path, 'w', encoding='utf-8') as file:
        file.write(modified_html)

    # Return the HTML content
    with open(html_path, 'r', encoding='utf-8') as file:
        return file.read()


# Main app
def main():
    st.title("Interactive Graph with Custom Popups")

    # Sidebar for options
    st.sidebar.header("Graph Options")

    # Option to regenerate graph
    if st.sidebar.button("Generate New Graph"):
        st.session_state.graph = create_sample_graph()

    # Initialize graph in session state if not already present
    if 'graph' not in st.session_state:
        st.session_state.graph = create_sample_graph()

    # Convert to pyvis and get HTML with custom popups
    pyvis_graph = create_pyvis_graph(st.session_state.graph)
    html_content = save_and_display_graph(pyvis_graph, st.session_state.graph)

    # Display instructions
    st.write("""
    ### Instructions:
    - **Click on a node** to see its detailed information in a custom popup
    - The popup will appear in the top right corner of the canvas and display:
      - Node ID
      - Node Type
      - Node Value
    - Click anywhere else to dismiss the popup
    """)

    # Display the graph
    components.html(html_content, height=600, scrolling=False)

    # Add an expander with additional information
    with st.expander("About This Visualization"):
        st.write("""
        This graph visualization uses pyvis to render an interactive network graph with custom popups.

        Instead of using the built-in tooltip functionality (which escapes HTML), this implementation
        creates custom DOM elements for the popups that properly render HTML content.

        The popups are positioned dynamically next to the nodes and will stay visible until you
        click elsewhere on the canvas.
        """)


if __name__ == "__main__":
    main()

    # Clean up the temporary HTML files when the app is closed
    temp_dir = Path("temp_pyvis_html")
    if temp_dir.exists():
        for file in temp_dir.glob("*.html"):
            try:
                file.unlink()
            except:
                pass
